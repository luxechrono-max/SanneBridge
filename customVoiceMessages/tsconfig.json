{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-native",
        "strict": false,
        "skipLibCheck": true,
        "noEmit": true,
        "allowJs": true
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx"
    ]
}
